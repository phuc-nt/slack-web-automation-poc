# Your own settings for infra/poc.sh. Copy to infra/local.env (ignored by git) and fill in.
# Values here override the profile in infra/profiles/.

# Region to deploy in. The Bedrock model must be invocable there.
AWS_REGION=
# Only when you sign in with a named AWS CLI profile
#AWS_PROFILE=

# IANA name of the time zone the reports and the schedule use
#TIME_ZONE=UTC
# HH:MM in TIME_ZONE to post the daily report every day; empty = only on /daily-report
#REPORT_TIME=
# Names the stacks and the Project tag
#APP=slack-web-automation-poc
