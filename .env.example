# --- Target portal (the mock portal by default) ---
PORTAL_BASE_URL=http://localhost:4010
PORTAL_USERNAME=demo-operator
PORTAL_PASSWORD=change-me-locally

# --- Mock portal ---
MOCK_PORTAL_PORT=4010

# --- Browser worker ---
# false = show the browser window while the worker fills the form
BROWSER_HEADLESS=true
# How long a filled form waits for approval before the browser is closed
APPROVAL_TTL_SECONDS=600

# --- LLM (optional: only used to pre-fill the form from free text) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Slack (Socket Mode: no public URL needed) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Daily report (optional: /daily-report and the daily schedule) ---
# Channel IDs to read, comma-separated. Invite the bot to each one first.
REPORT_CHANNELS=
# Channel ID the report is posted to
REPORT_POST_CHANNEL=
# Local time HH:MM to post every day; empty = only on /daily-report. Set TZ for the timezone.
REPORT_TIME=
REPORT_LANGUAGE=Vietnamese
# Model for the report; empty = OPENROUTER_MODEL
REPORT_MODEL=

# --- Jira Cloud (optional: adds the progress check to the report) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Overrides the default query (open issues of the project plus those updated in the last day)
JIRA_JQL=
